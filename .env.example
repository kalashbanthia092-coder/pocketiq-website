# Copy this file to `.env` and fill in real values.
# `.env` is gitignored, so it never reaches GitHub. Create it directly on the
# server when deploying.

# OpenAI. The code accepts either name, OPENAI_API_KEY wins if both are set.
OPENAI_KEY=sk-your-key-here

# SerpAPI, used by Compare mode for live shopping prices.
SERPAPI_API_KEY=your-serpapi-key-here

# Signs session cookies. MUST be a long random value in production, otherwise
# sessions can be forged. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Set to "production" when deployed. This turns on Secure-only session cookies
# (HTTPS). Leave unset locally so the plain-http dev server still works.
FLASK_ENV=

# Leave off in production. Only set to "true" while developing locally,
# otherwise template edits are cached and tracebacks leak to visitors.
FLASK_DEBUG=
